{
  "name": "@foresight-arena/agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The three showcase agents of Foresight Arena and the shared research -> position -> settle -> reputation loop they run.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "run:price": "tsx src/cli.ts price-sentinel",
    "run:chain": "tsx src/cli.ts chain-pulse",
    "run:score": "tsx src/cli.ts score-oracle",
    "run:all": "tsx src/cli.ts all"
  },
  "dependencies": {
    "@celo/attribution-tags": "^0.3.0",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

# --- network -----------------------------------------------------------
# Celo Sepolia (11142220) is the default. Mainnet is 42220 and requires a real
# attribution tag; the code refuses to broadcast without one.
CHAIN_ID=11142220
RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- wallet ------------------------------------------------------------
# Symbolic balances only. Never put a key here that controls anything else.
AGENT_PRIVATE_KEY=0x

# Pay gas in USDC through the fee adapter, so agent wallets need not hold CELO.
PAY_GAS_IN_USDC=true

# --- attribution (ERC-8021) -------------------------------------------
# Issued by https://celobuilders.xyz at registration: "celo_" + 12 hex characters.
# Leave unset on testnet; mainnet will not run until it is set to the real value.
# ATTRIBUTION_TAG=celo_xxxxxxxxxxxx

# --- deployed contracts -----------------------------------------------
FORESIGHT_POOL_ADDRESS=
MENTO_PRICE_RESOLVER_ADDRESS=
CHAIN_METRIC_RESOLVER_ADDRESS=
ATTESTED_SCORE_RESOLVER_ADDRESS=

# --- budget (base units; USDC has 6 decimals) --------------------------
# These may only tighten the on-chain caps, never loosen them.
MAX_STAKE_PER_POSITION=1000000
MAX_OPEN_EXPOSURE=10000000
MIN_CONFIDENCE=0.15

# Set to false to actually broadcast. Defaults to a dry run.
DRY_RUN=true

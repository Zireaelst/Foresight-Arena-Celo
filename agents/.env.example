# --- network -----------------------------------------------------------
# Celo Sepolia (11142220) is the default. Mainnet is 42220 and requires a real
# attribution tag; the code refuses to broadcast without one.
CHAIN_ID=11142220
RPC_URL=https://forno.celo-sepolia.celo-testnet.org

# --- wallets -----------------------------------------------------------
# Symbolic balances only. Never put a key here that controls anything else.
#
# Each agent holds its OWN key: an ERC-8004 identity shared between agents would make
# every agent's record the same record.
DEPLOYER_PRIVATE_KEY=0x
PRICE_SENTINEL_PRIVATE_KEY=0x
CHAIN_PULSE_PRIVATE_KEY=0x
SCORE_ORACLE_PRIVATE_KEY=0x

# The scorekeeper MUST be a different wallet from every agent. The ERC-8004 Reputation
# Registry rejects feedback from an agent's own owner ("Self-feedback not allowed"), so an
# agent physically cannot publish its own score -- see docs/DECISIONS.md D-10.
SCOREKEEPER_PRIVATE_KEY=0x

# Pay gas in USDC through the fee adapter instead of holding CELO. Leave false on testnet
# unless you have the adapter working; native CELO from the faucet is simpler.
PAY_GAS_IN_USDC=false

# --- attribution (ERC-8021) -------------------------------------------
# Issued by https://celobuilders.xyz at registration: "celo_" + 12 hex characters.
# Leave unset on testnet; mainnet will not run until it is set to the real value.
# ATTRIBUTION_TAG=celo_xxxxxxxxxxxx

# --- deployed contracts (written by scripts/deploy-testnet.sh) ---------
FORESIGHT_POOL_ADDRESS=
MENTO_PRICE_RESOLVER_ADDRESS=
CHAIN_METRIC_RESOLVER_ADDRESS=
ATTESTED_SCORE_RESOLVER_ADDRESS=
STAKE_TOKEN_ADDRESS=

# Testnet only: the stand-in price feed, because Mento's own Sepolia oracle is over a
# year stale (docs/DECISIONS.md D-11). Unused on mainnet.
TESTNET_PRICE_FEED_ADDRESS=
# Any address works as a rate feed id; cUSD keeps the market config portable to mainnet.
PRICE_RATE_FEED_ID=0xEF4d55D6dE8e8d73232827Cd1e9b2F2dBb45bC80

# --- ERC-8004 agent ids (written by `npm run ops:register`) -----------
PRICE_SENTINEL_AGENT_ID=
CHAIN_PULSE_AGENT_ID=
SCORE_ORACLE_AGENT_ID=

# --- budget (base units; USDC has 6 decimals) --------------------------
# These may only tighten the on-chain caps, never loosen them.
MAX_STAKE_PER_POSITION=1000000
MAX_OPEN_EXPOSURE=10000000
MIN_CONFIDENCE=0.15

# Set to false to actually broadcast. Defaults to a dry run.
DRY_RUN=true

# --- score consensus (D-07) -------------------------------------------
# How many independent providers must report the SAME final scoreline.
SCORE_FEED_QUORUM=2
# Optional third opinion. The panel works without it; nothing critical depends on a key.
# FOOTBALL_DATA_TOKEN=

# --- x402 data market (D-12) ------------------------------------------
# When set, Skor Kahini BUYS its score report over x402 instead of computing it locally.
# Unset it and the agent falls back to querying the APIs itself.
# DATA_MARKET_URL=http://127.0.0.1:4021
# Hard ceiling per purchase, in stake-token base units. Without a cap, an unattended
# agent would sign whatever price a seller named.
DATA_MARKET_MAX_PRICE=100000

# The seller's own knobs (read by services/data-market).
DATA_MARKET_PRICE=10000
# X402_FACILITATOR_URL=https://api.x402.sepolia.celo.org
# X402_API_KEY=

# --- dashboard --------------------------------------------------------
# Where agent registration documents are served from, for ERC-8004 agentURI.
PUBLIC_BASE_URL=http://localhost:3000

# --- seeding ----------------------------------------------------------
SEED_TRADING_MINUTES=20
SEED_SETTLE_MINUTES=5

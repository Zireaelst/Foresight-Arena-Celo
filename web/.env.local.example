# Celo Sepolia (11142220) varsayılan. Mainnet 42220 ister ve bilinçli bir karardır.
NEXT_PUBLIC_CHAIN_ID=11142220

# drpc birincil: forno dokümante edilen uç ama bu projenin deploy'u sırasında 503 döndü
# ve bir kez de gerçek olmayan "block 0" verdi. Alternatifler:
#   https://forno.celo-sepolia.celo-testnet.org
#   https://rpc.ankr.com/celo_sepolia
NEXT_PUBLIC_RPC_URL=https://celo-sepolia.drpc.org

# Yerel fork'a SADECE `scripts/local-e2e.sh` çalışırken çevir. Panel her istekte market

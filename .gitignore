# --- dependencies & build output ---
node_modules/
dist/

# Foundry
contracts/out/
contracts/cache/
contracts/broadcast/

# Deployment records are written by the deploy script. Local anvil-fork records stay out
# of git: anvil's addresses are deterministic and indistinguishable from real ones, so
# committing one would advertise a deployment that does not exist. A network the arena is
# genuinely live on is force-added instead -- the dashboard reads its addresses from here,
# and Vercel builds from git, so the file has to be in the repo.
contracts/deployments/*.json
!contracts/deployments/11142220.json

# --- secrets & local config ---
# Agent keys live here. Never commit .env; .env.example is the template.
.env
.env.backup
.env.local
.env.*.local
.claude/

# Installed agent skills are re-fetched with `npx skills add https://celobuilders.xyz`.
# skills-lock.json is committed so the pinned version is reproducible.
.agents/

# --- OS ---
.DS_Store
